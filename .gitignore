# --- OpenFOAM run artifacts (regenerated by Allrun/blockMesh/foamRun) ---
# Patterns are anchored per-case on purpose: a generic "0/" would wrongly
# ignore solverHeatBath/0/ (tracked initial conditions), and a generic
# "dynamicCode/" would hit etc/codeTemplates/dynamicCode/ (tracked templates).

# shockTube tutorial — 0/ is regenerated from the tracked 0.bak/
tutorials/shockThermo/shockTube/0/
tutorials/shockThermo/shockTube/[1-9]*/
tutorials/shockThermo/shockTube/0.[0-9]*/
tutorials/shockThermo/shockTube/constant/polyMesh/
tutorials/shockThermo/shockTube/dynamicCode/
tutorials/shockThermo/shockTube/postProcessing/
tutorials/shockThermo/shockTube/processor*/
tutorials/shockThermo/shockTube/log.*

# solverHeatBath test — 0/ holds the initial conditions (kept in git)
applications/test/nonEqTTv/solverHeatBath/[1-9]*/
applications/test/nonEqTTv/solverHeatBath/0.[0-9]*/
applications/test/nonEqTTv/solverHeatBath/constant/polyMesh/
applications/test/nonEqTTv/solverHeatBath/dynamicCode/
applications/test/nonEqTTv/solverHeatBath/postProcessing/
applications/test/nonEqTTv/solverHeatBath/processor*/
applications/test/nonEqTTv/solverHeatBath/log.*

# solverHeatBathReacting test — same layout; reference.csv is a copy of the
# canonical output/results-N2N-reacting-*.csv (already committed)
applications/test/nonEqTTv/solverHeatBathReacting/[1-9]*/
applications/test/nonEqTTv/solverHeatBathReacting/0.[0-9]*/
applications/test/nonEqTTv/solverHeatBathReacting/constant/polyMesh/
applications/test/nonEqTTv/solverHeatBathReacting/dynamicCode/
applications/test/nonEqTTv/solverHeatBathReacting/postProcessing/
applications/test/nonEqTTv/solverHeatBathReacting/processor*/
applications/test/nonEqTTv/solverHeatBathReacting/log.*
applications/test/nonEqTTv/solverHeatBathReacting/reference.csv

# Test-N2 transient output (canonical results committed with descriptive names)
applications/test/nonEqTTv/output/results-N2.csv

# shockTube1D validation cases — 0/ is a working copy of the tracked 0.bak/;
