// pressione iniziale, scritta da Allrun in conditions
#include "$FOAM_CASE/conditions"

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform $p;

boundaryField
{
    sides
    {
        type            zeroGradient;
    }
    empty
    {
        type            empty;
    }
}

