FoamFile
{
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

// T_tr iniziale del test 3a
// Vibrational heating case (paper Fig. 3a): T_tr = 10000 K, T_ve = 1000 K
internalField   uniform 10000;

// bordi: con il gas fermo non entra ne' esce nulla
boundaryField
{
    sides
    {
        type            zeroGradient;
    }

    empty
    {
        type            empty;
    }
}

