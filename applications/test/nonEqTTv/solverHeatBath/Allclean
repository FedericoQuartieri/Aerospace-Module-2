#!/bin/sh

cd ${0%/*} || exit 1

# removes only what is generated (mesh, results, logs); keeps 0/ and the setup
foamListTimes -rm 2>/dev/null
rm -rf constant/polyMesh postProcessing
rm -f log.blockMesh log.foamRun

# "conditions" is written by Allrun: it is kept only when Allrun calls Allclean
[ "$1" = keepConditions ] || rm -f conditions

