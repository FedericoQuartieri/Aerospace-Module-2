FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// "type highEnthalpyThermo" carica la termodinamica del progetto (il bridge)
thermoType
{
    type            highEnthalpyThermo;
    mixture         coefficientWilkeMulticomponentMixture;
    transport       sutherland;
    // janaf come nel tutorial shockTube: il thermo base non entra nella fisica,
    // T e Tve le ricava Mutation++ nel bridge (rrho non e' istanziato nella libreria)
    thermo          janaf;
    energy          sensibleInternalEnergy;
    equationOfState perfectGas;
    specie          specie;
}

// impostazioni di Mutation++, uguali ai programmi 0D (la cartella dati la
// sceglie Allrun con MPP_DATA_DIRECTORY); il meccanismo dipende dalla figura
#include "$FOAM_CASE/conditions"

highEnthalpyMutation
{
    mixture                 air_5;
    stateModel              ChemNonEqTTv;
    thermodynamicDatabase   RRHO;
    mechanism               $mechanism;
    // esponente a della temperatura di Park T^a Tv^(1-a) per la dissociazione
    parkExponent            $parkExponent;
}

defaultSpecie N2;

#include "speciesThermo.janaf"

