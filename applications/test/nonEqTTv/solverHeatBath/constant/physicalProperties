FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// "type highEnthalpyThermo" loads the project thermodynamics (the bridge)
thermoType
{
    type            highEnthalpyThermo;
    mixture         coefficientWilkeMulticomponentMixture;
    transport       sutherland;
    // rrho is the thermo of the course template (a copy of janaf); the base thermo
    // does not enter the physics: T and Tve are obtained by Mutation++ in the bridge
    thermo          rrho;
    energy          sensibleInternalEnergy;
    equationOfState perfectGas;
    specie          specie;
}

// Mutation++ settings, the same as the 0D programs (the data folder is chosen
// by Allrun through MPP_DATA_DIRECTORY); the mechanism depends on the figure
#include "$FOAM_CASE/conditions"

highEnthalpyMutation
{
    mixture                 air_5;
    stateModel              ChemNonEqTTv;
    thermodynamicDatabase   RRHO;
    mechanism               $mechanism;
    // exponent a of Park's temperature T^a Tv^(1-a) for dissociation
    parkExponent            $parkExponent;
    // choices of report table 1; without these entries the thermo uses the
    // model of report section 2.5.3 (mutation: tau of Mutation++;
    // nonPreferential: Q_C-V of report eq. 8). Here: V-T tau of eq. 9-17 as
    // in hy2Foam and preferential Q_C-V with alpha = 0.3 (eq. 32), as in the
    // hy2Foam heatBath tutorial, which is the case of fig. 7
    relaxationTime          paper;
    chemistryVibration      preferential;
    preferentialFactor      0.3;
}

defaultSpecie N2;

#include "speciesThermo.janaf"

