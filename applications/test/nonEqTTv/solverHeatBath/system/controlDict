FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// end time chosen by Allrun according to the figure
#include "$FOAM_CASE/conditions"

solver          shockThermo;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         $endTime;

// time step of 1 ns as in the paper
deltaT          1e-9;

writeControl    runTime;

writeInterval   1e-5;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

adjustTimeStep  no;

maxCo           0.1;

maxDeltaT       1;

functions
{
    // records the quantities in the cell every writeEvery steps: needed for the comparison
    probes
    {
        type            probes;
        libs            ("libsampling.so");
        writeControl    timeStep;
        writeInterval   $writeEvery;
        probeLocations  ((0 0 0));
        fields          (T Tve p rho N2 N);
    }
}

