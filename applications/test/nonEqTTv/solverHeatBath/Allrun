#!/bin/sh

cd ${0%/*} || exit 1

# heat bath in a single cell with the shockThermo solver, for one figure of the
# paper: ./Allrun fig3b   (fig3a, fig3b, fig4-noEl, fig4-el, fig5, fig7)
# optional second argument: Park exponent, e.g. ./Allrun fig7 0.5
# the initial conditions go into the file "conditions", included by the case
# files; the result goes to ../output/<figure>-solver.csv

fig=${1:-fig3a}

# ---- initial conditions of the paper, figure by figure
# p and mass fractions for N2 + N with 5e22 molecules/m3 each at 30000 K:
# p = n k T = 1e23 * 1.380649e-23 * 30000 = 41419.5 Pa, Y_N2 = 2/3, Y_N = 1/3
# (M_N2 = 2 M_N, so 2/3 and 1/3 are exact: written with 9 digits)
# "every": how many steps between probe writes (1, i.e. every ns; 10 in the
# long case). probes-to-csv.py then keeps every step at the beginning and 200
# points per decade afterwards, like the 0D programs, so the csv stays short
# but the first nanoseconds are all there
case $fig in
    fig3a)     Ttr=10000; Tve=1000;  p=101325;  YN2=1;      YN=0;      endTime=3e-5; every=1;   data=mutation-data-noElectronic; mechanism=none ;;
    fig3b)     Ttr=3000;  Tve=10000; p=101325;  YN2=1;      YN=0;      endTime=1e-4; every=1;   data=mutation-data-noElectronic; mechanism=none ;;
    fig4-noEl) Ttr=30000; Tve=1000;  p=101325;  YN2=1;      YN=0;      endTime=1e-5; every=1;   data=mutation-data-noElectronic; mechanism=none ;;
    fig4-el)   Ttr=30000; Tve=1000;  p=101325;  YN2=1;      YN=0;      endTime=1e-5; every=1;   data=mutation-data;              mechanism=none ;;
    fig5)      Ttr=30000; Tve=1000;  p=41419.5; YN2=0.666666667; YN=0.333333333; endTime=1e-5; every=1;   data=mutation-data-noElectronic; mechanism=none ;;
    fig7)      Ttr=30000; Tve=1000;  p=41419.5; YN2=0.666666667; YN=0.333333333; endTime=1e-3; every=10;  data=mutation-data-noElectronic; mechanism=N2_Park ;;
    *) echo "unknown figure: $fig"; exit 1 ;;
esac
# ---- end of initial conditions

# same Mutation++ data as the 0D program
export MPP_DATA_DIRECTORY="$(cd .. && pwd)/$data"

# exponent of Park's temperature (eq. 29): 0.7 as in the paper
parkExponent=${2:-0.7}

cat > conditions <<EOF
// initial conditions for $fig, written by Allrun
Ttr           $Ttr;
Tve           $Tve;
p             $p;
YN2           $YN2;
YN            $YN;
endTime       $endTime;
writeEvery    $every;
mechanism     $mechanism;
parkExponent  $parkExponent;
EOF

./Allclean keepConditions

blockMesh > log.blockMesh 2>&1 || { cat log.blockMesh; exit 1; }
foamRun > log.foamRun 2>&1 || { tail -30 log.foamRun; exit 1; }

# from the probes to the csv used by compare.py
python3 probes-to-csv.py $fig

#------------------------------------------------------------------------------
