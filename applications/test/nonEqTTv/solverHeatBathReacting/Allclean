#!/bin/sh

cd ${0%/*} || exit 1

# Remove generated artifacts only (mesh, results, logs); keep 0/ and setup.
# dynamicCode must go too: OpenFOAM does not rebuild it when the
# highEnthalpyThermo header changes (the SHA1 only covers the template).
foamListTimes -rm 2>/dev/null
rm -rf constant/polyMesh postProcessing dynamicCode
rm -f log.blockMesh log.foamRun reference.csv heatbath-reacting-comparison.png

