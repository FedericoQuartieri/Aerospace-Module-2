<!--
  thermodynamic data of the 5 air species, taken from the paper
  Casseau et al., Aerospace 2016, 3, 34: table A1 (theta_v, enthalpies of
  formation) and table A2 (electronic levels, converted from K to 1/cm
  by dividing by the second radiation constant hc/k = 1.438777 cm K)

  VERSION WITHOUT ELECTRONIC ENERGY: ground level only
  (cases "without electronic energy" of the paper: fig. 3a, 3b, 4)
-->
<specieslist>
    <species name="N">
        <stoichiometry> N: 1 </stoichiometry>
        <thermodynamics type="RRHO">
            <electronic_levels units="1/cm">
                <level degeneracy="4" energy="0.0" />
            </electronic_levels>
            <formation_enthalpy T="298 K" P="1 atm" units="J/mol"> 472025.8 </formation_enthalpy>
        </thermodynamics>
    </species>
    <species name="O">
        <stoichiometry> O: 1 </stoichiometry>
        <thermodynamics type="RRHO">
            <electronic_levels units="1/cm">
                <level degeneracy="9" energy="0.0" />
            </electronic_levels>
            <formation_enthalpy T="298 K" P="1 atm" units="J/mol"> 249590.6 </formation_enthalpy>
        </thermodynamics>
    </species>
    <species name="NO">
        <stoichiometry> N: 1, O: 1 </stoichiometry>
        <thermodynamics type="RRHO">
            <linear> yes </linear>
            <rotational_temperature units="K"> 2.464 </rotational_temperature>
            <steric_factor> 1 </steric_factor>
            <vibrational_temperatures units="K"> 2719.0 </vibrational_temperatures>
            <electronic_levels units="1/cm">
                <level degeneracy="4" energy="0.0" />
            </electronic_levels>
            <formation_enthalpy T="298 K" P="1 atm" units="J/mol"> 91218.5 </formation_enthalpy>
        </thermodynamics>
    </species>
    <species name="N2">
        <stoichiometry> N: 2 </stoichiometry>
        <thermodynamics type="RRHO">
            <linear> yes </linear>
            <rotational_temperature units="K"> 2.886 </rotational_temperature>
            <steric_factor> 2 </steric_factor>
            <vibrational_temperatures units="K"> 3371.0 </vibrational_temperatures>
            <electronic_levels units="1/cm">
                <level degeneracy="1" energy="0.0" />
            </electronic_levels>
            <formation_enthalpy T="298 K" P="1 atm" units="J/mol"> 0.0 </formation_enthalpy>
        </thermodynamics>
    </species>
    <species name="O2">
        <stoichiometry> O: 2 </stoichiometry>
        <thermodynamics type="RRHO">
            <linear> yes </linear>
            <rotational_temperature units="K"> 2.086 </rotational_temperature>
            <steric_factor> 2 </steric_factor>
            <vibrational_temperatures units="K"> 2256.0 </vibrational_temperatures>
            <electronic_levels units="1/cm">
                <level degeneracy="3" energy="0.0" />
            </electronic_levels>
            <formation_enthalpy T="298 K" P="1 atm" units="J/mol"> 0.0 </formation_enthalpy>
        </thermodynamics>
    </species>
</specieslist>
