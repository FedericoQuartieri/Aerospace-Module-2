<!--
  the 19 QK (Quantum-Kinetic) reactions of 5-species air used by the paper for
  fig. 9: 15 dissociations and 4 exchanges, irreversible, with the Arrhenius
  constants of Scanlon et al., AIAA J. 53 (2015), table 1, taken from the
  hTCReactionsQK file of hyStrath (see README.md in this folder)
  units: A in cm3/mol/s (in the hyStrath file it is in m3/kmol/s: x 1000), Ta in K

  Mutation++ does not accept, in the same mechanism, two irreversible reactions
  that are the reverse of each other: this file holds the 15 dissociations and
  the two "forward" exchanges (NO+O -> O2+N, N2+O -> NO+N); the two reverse
  exchanges are in air5_QK_back.xml and must be added to these
-->
<mechanism name="air5_QK">

    <arrhenius_units A="mol,cm,s,K" E="kcal,mol,K" />

    <!-- O2 + N = 2O + N: dissociation -->
    <reaction formula="O2+N=>2O+N">
        <arrhenius A="6.624E+19" n="-1.0" T="59370.6" />
    </reaction>

    <!-- O2 + NO = 2O + NO: dissociation -->
    <reaction formula="O2+NO=>2O+NO">
        <arrhenius A="6.624E+19" n="-1.0" T="59370.6" />
    </reaction>

    <!-- O2 + N2 = 2O + N2: dissociation -->
    <reaction formula="O2+N2=>2O+N2">
        <arrhenius A="7.829E+19" n="-1.0" T="59370.6" />
    </reaction>

    <!-- O2 + O2 = 2O + O2: dissociation -->
    <reaction formula="O2+O2=>2O+O2">
        <arrhenius A="3.21E+19" n="-1.0" T="59370.6" />
    </reaction>

    <!-- O2 + O = 2O + O: dissociation -->
    <reaction formula="O2+O=>2O+O">
        <arrhenius A="9.033E+19" n="-1.05" T="59370.6" />
    </reaction>

    <!-- N2 + O = 2N + O: dissociation -->
    <reaction formula="N2+O=>2N+O">
        <arrhenius A="2.409E+18" n="-0.54" T="113497.4" />
    </reaction>

    <!-- N2 + O2 = 2N + O2: dissociation -->
    <reaction formula="N2+O2=>2N+O2">
        <arrhenius A="9.033E+18" n="-0.68" T="113497.4" />
    </reaction>

    <!-- N2 + NO = 2N + NO: dissociation -->
    <reaction formula="N2+NO=>2N+NO">
        <arrhenius A="9.033E+18" n="-0.68" T="113497.4" />
    </reaction>

    <!-- N2 + N2 = 2N + N2: dissociation -->
    <reaction formula="N2+N2=>2N+N2">
        <arrhenius A="2.469E+18" n="-0.62" T="113497.4" />
    </reaction>

    <!-- N2 + N = 2N + N: dissociation -->
    <reaction formula="N2+N=>2N+N">
        <arrhenius A="6.022E+18" n="-0.68" T="113497.4" />
    </reaction>

    <!-- NO + N2 = N + O + N2: dissociation -->
    <reaction formula="NO+N2=>N+O+N2">
        <arrhenius A="1.265E+20" n="-1.0" T="75544.2" />
    </reaction>

    <!-- NO + O2 = N + O + O2: dissociation -->
    <reaction formula="NO+O2=>N+O+O2">
        <arrhenius A="1.204E+20" n="-1.0" T="75544.2" />
    </reaction>

    <!-- NO + NO = N + O + NO: dissociation -->
    <reaction formula="NO+NO=>N+O+NO">
        <arrhenius A="6.022E+19" n="-1.0" T="75544.2" />
    </reaction>

    <!-- NO + O = N + 2O: dissociation -->
    <reaction formula="NO+O=>N+2O">
        <arrhenius A="2.409E+20" n="-1.1" T="75544.2" />
    </reaction>

    <!-- NO + N = O + 2N: dissociation -->
    <reaction formula="NO+N=>O+2N">
        <arrhenius A="2.409E+20" n="-1.1" T="75544.2" />
    </reaction>

    <!-- NO + O = O2 + N: exchange -->
    <reaction formula="NO+O=>O2+N">
        <arrhenius A="1.385E+11" n="0.5" T="19693.6" />
    </reaction>

    <!-- N2 + O = NO + N: exchange -->
    <reaction formula="N2+O=>NO+N">
        <arrhenius A="4.818E+13" n="0" T="37482.4" />
    </reaction>

</mechanism>
