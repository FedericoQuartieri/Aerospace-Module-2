<!--
  the two reverse exchanges of the QK set (see air5_QK.xml and README.md): same
  source and same units; Mutation++ rejects them together with the forward
  ones, so they live in a second mechanism whose rates are added
-->
<mechanism name="air5_QK_back">

    <arrhenius_units A="mol,cm,s,K" E="kcal,mol,K" />

    <!-- O2 + N = NO + O: exchange -->
    <reaction formula="O2+N=>NO+O">
        <arrhenius A="2.409E+15" n="-0.39" T="1448.6" />
    </reaction>

    <!-- NO + N = N2 + O: exchange -->
    <reaction formula="NO+N=>N2+O">
        <arrhenius A="3.011E+14" n="-0.35" T="1448.6" />
    </reaction>

</mechanism>
