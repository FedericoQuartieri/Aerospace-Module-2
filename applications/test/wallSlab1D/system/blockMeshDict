FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;

vertices
(
    (0 -0.05 -0.05)
    ( 0.01 -0.05 -0.05)
    ( 0.01  0.05 -0.05)
    (0  0.05 -0.05)
    (0 -0.05  0.05)
    ( 0.01 -0.05  0.05)
    ( 0.01  0.05  0.05)
    (0  0.05  0.05)
);

blocks
(
    // 1D conduction slab: 50 cells, isothermal wall at x=0
    hex (0 1 2 3 4 5 6 7) (50 1 1) simpleGrading (1 1 1)
);

boundary
(
    wall
    {
        type wall;
        faces
        (
            (0 4 7 3)
        );
    }

    farField
    {
        type patch;
        faces
        (
            (1 2 6 5)
        );
    }

    empty
    {
        type empty;
        faces
        (
            (0 1 5 4)
            (3 7 6 2)
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

