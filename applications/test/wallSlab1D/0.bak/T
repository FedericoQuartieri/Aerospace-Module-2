FoamFile
{
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

// Reacting N2-N heat bath (paper Fig. 7): T_tr = 30000 K, T_ve = 1000 K
internalField   uniform 1000;

boundaryField
{
    wall
    {
        type            fixedValue;
        value           uniform 300;
    }

    farField
    {
        type            zeroGradient;
    }

    empty
    {
        type            empty;
    }
}

