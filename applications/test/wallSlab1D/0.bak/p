FoamFile
{
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

// 1 atm, as in the standalone Test-N2 heat bath
internalField   uniform 10000;

boundaryField
{
    wall
    {
        type            zeroGradient;
    }

    farField
    {
        type            zeroGradient;
    }

    empty
    {
        type            empty;
    }
}

