FoamFile
{
    format      ascii;
    class       volScalarField;
    object      Tve;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 144.4;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 144.4;
    }

    outlet
    {
        type            zeroGradient;
    }

    wall
    {
        type            zeroGradient;
    }

    wedge0 { type wedge; }
    wedge1 { type wedge; }
}

