FoamFile
{
    format      ascii;
    class       volScalarField;
    object      Ydefault;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0;
    }

    outlet          { type zeroGradient; }
    wall            { type zeroGradient; }
    wedge0          { type wedge; }
    wedge1          { type wedge; }
}

