FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            highEnthalpyThermo;
    mixture         coefficientWilkeMulticomponentMixture;
    transport       sutherland;
    thermo          rrho;
    energy          sensibleInternalEnergy;
    equationOfState perfectGas;
    specie          specie;
}

// Same Mutation++ configuration as the standalone nonEqTTv tests:
// 5-species air, two-temperature RRHO, N2 dissociation (relaxing tube).
// Run with MPP_DATA_DIRECTORY pointing to nonEqTTv/mutation-data-noel.
highEnthalpyMutation
{
    mixture                 air_5;
    stateModel              ChemNonEqTTv;
    thermodynamicDatabase   RRHO;
    mechanism               N2_diss_park;
    minTemperature          200;
    maxTemperature          50000;
    minPressure             1;
    forceThermalEquilibrium no;
}

// V-T relaxation: tauVT and the source terms are computed per-cell from
// Mutation++; the solver solves a conservative equation for the
// vibro-electronic energy eve. The solved sensible energy e lives on the
// Mutation++ datum e = e_tr(T) + e_ve(Tve), so the V-T exchange affects T
// only through the decode T(e - eve): no coupling switch is needed.
highEnthalpyRelaxation
{
    solveEve        yes;
}

defaultSpecie N2;

#include "speciesThermo.janaf"

