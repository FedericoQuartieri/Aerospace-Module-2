FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// High-enthalpy driver: strong shock (Ms ~ 8) with VT relaxation zone.
// Left (driver): p = 5e6 Pa, T = 3000 K
// Right (driven): p = 1000 Pa, T = 300 K

defaultValues
{
    U       (0 0 0);
    T       3000;
    Tve     3000;
    p       5e6;
}

zones
{
    rightSide
    {
        type        box;
        box         (0 -1 -1) (10 1 1);

        values
        {
            T       300;
            Tve     300;
            p       1000;
        }
    }
}

