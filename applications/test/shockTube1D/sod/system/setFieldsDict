{
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Sod shock tube in pure N2 (frozen, cold: gamma = 1.4).
// Left (driver): p = 1e5 Pa, T = 348.432 K -> rho = 0.9670 kg/m^3
// Right (driven): p = 1e4 Pa, T = 278.746 K -> rho = 0.1209 kg/m^3

defaultValues
{
    U       (0 0 0);
    T       348.432;
    Tve     348.432;
    p       100000;
}

zones
{
    rightSide
    {
        type        box;
        box         (0 -1 -1) (10 1 1);

        values
        {
            T       278.746;
            Tve     278.746;
            p       10000;
        }
    }
}

