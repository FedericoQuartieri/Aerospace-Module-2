FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          shockThermo;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

// LTS pseudo-time: 3e-3/1e-7 = 30k iterazioni, come il cono M5/M6
// (la convergenza va comunque verificata sulla stabilita' dei campi
// tra checkpoint, non sul timeout)
endTime         9e-3;

deltaT          1e-7;

writeControl    adjustableRunTime;

writeInterval   2e-4;

cycleWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

adjustTimeStep  no;

maxCo           0.1;

maxDeltaT       1;

functions
{}

