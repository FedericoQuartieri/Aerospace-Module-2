FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Tve;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Wall held at a uniform 1000 K with full accommodation (paper):
// the vibrational pool equilibrates to the wall temperature too.
dimensions      [0 0 0 1 0 0 0];

internalField   uniform 220;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 220;
    }

    outlet
    {
        type            zeroGradient;
    }

    wall
    {
        // zeroGradient come nel cono M5/M6, NON fixedValue Tw: la EveEqn
        // non ha (ancora) diffusione del pool ve (kappa_ve), quindi un
        // valore imposto a parete non ha alcun meccanismo per propagarsi
        // e innesca una scacchiera odd-even di eve nelle prime celle
        // (verificato sul coarse cluster: T al floor del limiter, p 2x).
        // Costo noto: q_w senza contributo vibrazionale, come nel cono.
        // Il fix vero (kappa_ve = mu*cv_ve alla Eucken -> laplacian(mu,
        // eve)) e' il passo successivo di M7.
        type            zeroGradient;
    }

    symm            { type symmetryPlane; }
    frontAndBack    { type empty; }
}

