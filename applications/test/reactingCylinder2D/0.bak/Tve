FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Tve;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Wall held at a uniform 1000 K with full accommodation (paper):
// the vibrational pool equilibrates to the wall temperature too.
dimensions      [0 0 0 1 0 0 0];

internalField   uniform 220;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 220;
    }

    outlet
    {
        type            zeroGradient;
    }

    wall
    {
        type            fixedValue;
        value           uniform 1000;
    }

    symm            { type symmetryPlane; }
    frontAndBack    { type empty; }
}

