FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Tve;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Wall held at a uniform 1000 K with full accommodation (paper):
// the vibrational pool equilibrates to the wall temperature too.
dimensions      [0 0 0 1 0 0 0];

internalField   uniform 220;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 220;
    }

    outlet
    {
        type            zeroGradient;
    }

    wall
    {
        // M8: ora che la EveEqn ha la diffusione del pool ve
        // (laplacian(mu,eve), Eucken kappa_ve=mu*cv_ve) il valore di
        // parete si propaga e NON innesca piu' la scacchiera odd-even che
        // in M7 aveva costretto a zeroGradient. Jump di Smoluchowski come
        // per T (paper: jump su entrambe le temperature, accommodation 1,
        // parete a 1000 K): da' il flusso termico vibrazionale a parete
        // che mancava -> C_H atteso piu' vicino al paper (era 74 vs 88).
        type            smoluchowskiJumpT;
        accommodationCoeff 1.0;
        Twall           uniform 1000;
        gamma           1.4;
        value           uniform 1000;
    }

    symm            { type symmetryPlane; }
    frontAndBack    { type empty; }
}

