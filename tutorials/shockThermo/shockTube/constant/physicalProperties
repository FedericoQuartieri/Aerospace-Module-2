FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            highEnthalpyThermo; 
    mixture         coefficientWilkeMulticomponentMixture;
    transport       sutherland; // gupta
    thermo          rrho;
    energy          sensibleInternalEnergy;
    equationOfState perfectGas;
    specie          specie;
}

highEnthalpyMutation
{
    mixture                 air_11;
    stateModel              ChemNonEqTTv;
    thermodynamicDatabase   RRHO;
    mechanism               none;
    minTemperature          298.15;
    maxTemperature          50000;
    minPressure             1;
    forceThermalEquilibrium no;
}

// V-T relaxation: tauVT and the source terms are now computed per-cell from
// Mutation++ (Millikan-White + Park through the transfer database); the
// solver solves a conservative equation for the vibro-electronic energy eve.
highEnthalpyRelaxation
{
    solveEve        yes;
}

defaultSpecie N2;

#include "speciesThermo.janaf"

