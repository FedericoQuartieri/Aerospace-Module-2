digraph G {
  graph [rankdir=TB, fontname="DejaVu Sans", labelloc=t, fontsize=30, pad=0.5, nodesep=0.45, ranksep=0.8, label=<<B>3 · Cosa succede quando lanci il test 3a (solverHeatBath/Allrun)</B><BR/> >];
  node [fontname="DejaVu Sans", fontsize=13, margin="0.14,0.07"];
  edge [fontname="DejaVu Sans", fontsize=12];
    k_allrun [shape=box, style="rounded,filled,solid", fillcolor="#E3F4E1", color="#3C8D3C", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>solverHeatBath/Allrun</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">applications/test/nonEqTTv/</FONT></TD></TR></TABLE>>];
    t_out [shape=box, style="rounded,filled,dashed", fillcolor="#F7F7F7", color="#3C8D3C", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>output/results-N2.csv</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">generato da Test-N2</FONT></TD></TR></TABLE>>];
    k_ref [shape=box, style="rounded,filled,dashed", fillcolor="#F7F7F7", color="#3C8D3C", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>reference.csv</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">generato da Allrun</FONT></TD></TR></TABLE>>];
    k_bmd [shape=box, style="rounded,filled,solid", fillcolor="#E3F4E1", color="#3C8D3C", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>system/blockMeshDict</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">una sola cella</FONT></TD></TR></TABLE>>];
    k_ctrl [shape=box, style="rounded,filled,solid", fillcolor="#E3F4E1", color="#3C8D3C", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>system/controlDict</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">solver shockThermo; deltaT 1e-9; endTime 2e-5</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">probes T Tve p</FONT></TD></TR></TABLE>>];
    k_pp [shape=box, style="rounded,filled,solid", fillcolor="#E3F4E1", color="#3C8D3C", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>constant/physicalProperties</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">+ #include speciesThermo.janaf</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">thermoType: highEnthalpyThermo ... thermo rrho</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">highEnthalpyMutation { mixture air_5 ... }</FONT></TD></TR></TABLE>>];
    k_0 [shape=box, style="rounded,filled,solid", fillcolor="#E3F4E1", color="#3C8D3C", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>0/T  0/p  0/U  0/Tve  0/N2  0/Ydefault</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">T=10000, Tve=1000, p=101325, U=0</FONT></TD></TR></TABLE>>];
    k_mt [shape=box, style="rounded,filled,solid", fillcolor="#E3F4E1", color="#3C8D3C", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>constant/momentumTransport</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">laminar</FONT></TD></TR></TABLE>>];
    k_fv [shape=box, style="rounded,filled,solid", fillcolor="#E3F4E1", color="#3C8D3C", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>system/fvSchemes, fvSolution</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">div(phi,Yi_h); solver (Tve|eve).*, Yi.*</FONT></TD></TR></TABLE>>];
    k_probes [shape=box, style="rounded,filled,dashed", fillcolor="#F7F7F7", color="#3C8D3C", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>postProcessing/probes/0/</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">generato da foamRun</FONT></TD></TR></TABLE>>];
    k_cmp [shape=box, style="rounded,filled,solid", fillcolor="#E3F4E1", color="#3C8D3C", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>compare-heatbath.py</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">errori massimi + grafico</FONT></TD></TR></TABLE>>];
    tut [shape=box, style="rounded,filled,solid", fillcolor="#E3F4E1", color="#3C8D3C", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>tutorials/shockThermo/shockTube/</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">stesso heat bath, thermo janaf</FONT></TD></TR></TABLE>>];
    exe_n2 [shape=component, style="rounded,filled,solid", fillcolor="#FFF4B8", color="#A68A00", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>Test-N2</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">$FOAM_USER_APPBIN</FONT></TD></TR></TABLE>>];
    lib_st [shape=component, style="rounded,filled,solid", fillcolor="#FFF4B8", color="#A68A00", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>libshockThermo.so</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">$FOAM_USER_LIBBIN</FONT></TD></TR></TABLE>>];
    lib_mpp [shape=component, style="rounded,filled,solid", fillcolor="#FFF4B8", color="#A68A00", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>libmutation++.so</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">thirdParty/Mutationpp/install/lib/</FONT></TD></TR></TABLE>>];
    m_data [shape=box, style="rounded,filled,solid", fillcolor="#FDE8D0", color="#C66A00", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>nonEqTTv/mutation-data/</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">mixtures/air_5.xml, thermo/species.xml,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">thermo/elements.xml, transfer/VT.xml, ...</FONT></TD></TR></TABLE>>];
    c_foamRun [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>foamRun.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">applications/solvers/foamRun/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">ciclo: prePredictor, momentumPredictor,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">thermophysicalPredictor, pressureCorrector</FONT></TD></TR></TABLE>>];
    c_solverNew [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>solverNew.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">src/finiteVolume/solver/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">libs.open(&quot;lib&quot; + solverName + &quot;.so&quot;)</FONT></TD></TR></TABLE>>];
    c_btNew [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>basicThermoTemplates.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">src/thermophysicalModels/basic/basicThermo/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">basicThermo::New:</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">1) cerca il tipo nella tabella statica</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">2) altrimenti dynamicCode, con il template</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">    che ha il NOME DELLA CLASSE</FONT></TD></TR></TABLE>>];
    c_basic [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>basicThermo.H</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">src/thermophysicalModels/basic/</FONT></TD></TR></TABLE>>];
    c_mc [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>multicomponentThermo.H</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">src/thermophysicalModels/multicomponentThermo/</FONT></TD></TR></TABLE>>];
    c_comb [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>combustionModel.H / combustionModelNew.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">src/combustionModels/</FONT></TD></TR></TABLE>>];
    c_sfcore [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>shockFluid/*.C del core</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">applications/modules/shockFluid/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">correctDensity, fluxPredictor, momentumPredictor,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">moveMesh, pressureCorrector, setRDeltaT,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">thermophysicalPredictor + derivedFvPatchFields</FONT></TD></TR></TABLE>>];
    s_stC [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>shockThermo.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">costruttore + preSolve()</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">registra &#x27;shockThermo&#x27; nella tabella solver</FONT></TD></TR></TABLE>>];
    s_heC [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>highEnthalpyMulticomponentThermo.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">New(): chiama basicThermo::New</FONT></TD></TR></TABLE>>];
    s_heS [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>highEnthalpyMulticomponentThermos.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">istanziazioni statiche forCoeffGases/forGases</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">(janaf, eConst, hConst: MAI rrho)</FONT></TD></TR></TABLE>>];
    s_HE [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>HighEnthalpyMulticomponentThermo.H</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">IL BRIDGE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">costruttore, computeSourceVT(), correct(),</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">initMutation()</FONT></TD></TR></TABLE>>];
    s_heH [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>highEnthalpyMulticomponentThermo.H</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">src/.../highEnthalpyMulticomponentThermo/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">classe astratta: Tve(), eve(), computeSourceVT()</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">classe composite: campi Tve_, eve_</FONT></TD></TR></TABLE>>];
    s_sf [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>shockFluid.H / shockFluid.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">applications/modules/shockFluid/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">copia modificata del core:</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">fluidThermo invece di psiThermo</FONT></TD></TR></TABLE>>];
    s_rdt [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>setRDeltaT.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">passo locale (LTS)</FONT></TD></TR></TABLE>>];
    s_tp [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>thermophysicalPredictor.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">specie, energia e, equazione di eve</FONT></TD></TR></TABLE>>];
    miss_tmpl [shape=box, style="rounded,filled,dashed", fillcolor="#FDE0E0", color="#C62828", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>codeTemplates/dynamicCode/highEnthalpyMulticomponentThermo</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">NON ESISTE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">ne&#x27; nel progetto, ne&#x27; in ~/.OpenFOAM, ne&#x27; nel core</FONT></TD></TR></TABLE>>];
    miss_comb [shape=box, style="rounded,filled,dashed", fillcolor="#FDE0E0", color="#C62828", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>constant/combustionProperties</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">ASSENTE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">-&gt; noCombustion</FONT></TD></TR></TABLE>>];
  k_allrun -> exe_n2 [color="#E65100", penwidth=2.4, arrowhead=normal, label=" 1  Test-N2 10000 1000 "];
  exe_n2 -> m_data [color="#2E7D32", style=dotted, penwidth=2, arrowhead=open, label=" legge "];
  exe_n2 -> t_out [color="#2E7D32", style=dotted, penwidth=2, arrowhead=open, label=" scrive "];
  t_out -> k_ref [color="#2E7D32", style=dotted, penwidth=2, arrowhead=open, label=" copiato "];
  k_allrun -> m_data [color="#00796B", style=dashed, penwidth=1.6, arrowhead=odiamond, label=" export MPP_DATA_DIRECTORY "];
  k_allrun -> k_bmd [color="#E65100", penwidth=2.4, arrowhead=normal, label=" 2  blockMesh "];
  k_allrun -> c_foamRun [color="#E65100", penwidth=2.4, arrowhead=normal, label=" 3  foamRun "];
  c_foamRun -> k_ctrl [color="#2E7D32", style=dotted, penwidth=2, arrowhead=open, label=" legge 'solver' "];
  c_foamRun -> c_solverNew [color="#E65100", penwidth=2.4, arrowhead=normal, label=" 4 "];
  c_solverNew -> lib_st [color="#E65100", penwidth=2.4, arrowhead=normal, label=" carica "];
  c_solverNew -> s_stC [color="#E65100", penwidth=2.4, arrowhead=normal, label=" 5  crea shockThermo "];
  s_stC -> s_heC [color="#E65100", penwidth=2.4, arrowhead=normal, label=" 6  ::New "];
  s_heC -> c_btNew [color="#E65100", penwidth=2.4, arrowhead=normal, label=" 7  basicThermo::New "];
  c_btNew -> k_pp [color="#2E7D32", style=dotted, penwidth=2, arrowhead=open, label=" legge thermoType "];
  c_btNew -> s_heS [color="#E65100", penwidth=2.4, arrowhead=normal, label=" 8a  janaf: nella tabella statica "];
  c_btNew -> miss_tmpl [color="#E65100", penwidth=2.4, arrowhead=normal, label=" 8b  rrho: non in tabella,
template assente -> FatalError "];
  s_heS -> s_HE [color="#E65100", penwidth=2.4, arrowhead=normal, label=" 9  costruisce il bridge "];
  s_HE -> lib_mpp [color="#E65100", penwidth=2.4, arrowhead=normal, label=" 10  initMutation "];
  s_HE -> k_pp [color="#2E7D32", style=dotted, penwidth=2, arrowhead=open, label=" legge highEnthalpyMutation "];
  lib_mpp -> m_data [color="#2E7D32", style=dotted, penwidth=2, arrowhead=open, label=" legge "];
  s_heH -> k_0 [color="#2E7D32", style=dotted, penwidth=2, arrowhead=open, label=" 0/Tve "];
  c_basic -> k_0 [color="#2E7D32", style=dotted, penwidth=2, arrowhead=open, label=" 0/T, 0/p "];
  c_mc -> k_0 [color="#2E7D32", style=dotted, penwidth=2, arrowhead=open, label=" 0/N2, 0/Ydefault "];
  s_sf -> k_0 [color="#2E7D32", style=dotted, penwidth=2, arrowhead=open, label=" 0/U "];
  s_sf -> k_mt [color="#2E7D32", style=dotted, penwidth=2, arrowhead=open, label=" legge "];
  s_stC -> c_comb [color="#E65100", penwidth=2.4, arrowhead=normal, label=" combustionModel::New "];
  c_comb -> miss_comb [color="#2E7D32", style=dotted, penwidth=2, arrowhead=open, label=" cerca "];
  s_stC -> s_rdt [color="#E65100", penwidth=2.4, arrowhead=normal, label=" preSolve: solo se LTS
(test 3a: Euler, non usato) ", style=dashed];
  c_foamRun -> c_sfcore [color="#E65100", penwidth=2.4, arrowhead=normal, label=" a ogni passo:
flussi, velocita', pressione "];
  c_foamRun -> s_tp [color="#E65100", penwidth=2.4, arrowhead=normal, label=" 11  a ogni passo "];
  s_tp -> s_HE [color="#E65100", penwidth=2.4, arrowhead=normal, label=" 12  computeSourceVT(), correct() "];
  s_tp -> k_fv [color="#2E7D32", style=dotted, penwidth=2, arrowhead=open, label=" schemi e solver "];
  c_foamRun -> k_probes [color="#2E7D32", style=dotted, penwidth=2, arrowhead=open, label=" scrive "];
  k_allrun -> k_cmp [color="#E65100", penwidth=2.4, arrowhead=normal, label=" 13  confronto "];
  k_cmp -> k_ref [color="#2E7D32", style=dotted, penwidth=2, arrowhead=open, label=" legge "];
  k_cmp -> k_probes [color="#2E7D32", style=dotted, penwidth=2, arrowhead=open, label=" legge "];
  tut -> s_heS [color="#E65100", penwidth=2.4, arrowhead=normal, label=" thermo janaf: tabella statica ", style=dashed];
}
