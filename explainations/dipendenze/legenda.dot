digraph L { graph [pad=0.4]; node [fontname="DejaVu Sans", fontsize=15]; legend [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="5" CELLPADDING="5"><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="34"><B>Aerospace-Module-2 (branch revised): dipendenze fra i file</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="16">Verificato sui sorgenti del progetto, sui sorgenti di OpenFOAM-13 e sul Doxygen cpp.openfoam.org/v13</FONT></TD></TR><TR><TD BGCOLOR="#DCEBFA" BORDER="1" COLOR="#2E6DB4" ALIGN="LEFT">tuo codice</TD><TD ALIGN="LEFT"><FONT COLOR="#333333"><B>━━▶</B></FONT>  #include</TD></TR><TR><TD BGCOLOR="#EFEFEF" BORDER="1" COLOR="#6E6E6E" ALIGN="LEFT">OpenFOAM-13 (core)</TD><TD ALIGN="LEFT"><FONT COLOR="#8E24AA"><B>━━▷</B></FONT>  eredita da (l&#x27;#include e&#x27; sottinteso)</TD></TR><TR><TD BGCOLOR="#FDE8D0" BORDER="1" COLOR="#C66A00" ALIGN="LEFT">Mutation++</TD><TD ALIGN="LEFT"><FONT COLOR="#1565C0"><B>╍╍▶</B></FONT>  compila / linka / produce</TD></TR><TR><TD BGCOLOR="#E3F4E1" BORDER="1" COLOR="#3C8D3C" ALIGN="LEFT">caso / test</TD><TD ALIGN="LEFT"><FONT COLOR="#E65100"><B>━━▶</B></FONT>  chiama o carica a runtime (numeri = ordine)</TD></TR><TR><TD BGCOLOR="#FFF4B8" BORDER="1" COLOR="#A68A00" ALIGN="LEFT">libreria o eseguibile</TD><TD ALIGN="LEFT"><FONT COLOR="#2E7D32"><B>┈┈▷</B></FONT>  legge o scrive un file</TD></TR><TR><TD BGCOLOR="#E8E4F6" BORDER="1" COLOR="#5E4FA2" ALIGN="LEFT">script di compilazione</TD><TD ALIGN="LEFT"><FONT COLOR="#00796B"><B>╍╍◇</B></FONT>  variabili d&#x27;ambiente</TD></TR><TR><TD BGCOLOR="#E0F2F1" BORDER="1" COLOR="#00796B" ALIGN="LEFT">ambiente</TD><TD ALIGN="LEFT"><FONT COLOR="#9E9E9E"><B>╍╍▷</B></FONT>  copia / commentato</TD></TR><TR><TD BGCOLOR="#F7F7F7" BORDER="1" COLOR="#3C8D3C" ALIGN="LEFT">file generato</TD><TD></TD></TR><TR><TD BGCOLOR="#FDE0E0" BORDER="1" COLOR="#C62828" ALIGN="LEFT">file ASSENTE</TD><TD></TD></TR><TR><TD BGCOLOR="#DCEBFA" BORDER="1" COLOR="#C62828" ALIGN="LEFT"