digraph G {
  graph [rankdir=TB, fontname="DejaVu Sans", labelloc=t, fontsize=30, pad=0.5, nodesep=0.45, ranksep=0.8, label=<<B>2 · #include ed ereditarieta&#x27; delle classi</B><BR/> >];
  node [fontname="DejaVu Sans", fontsize=13, margin="0.14,0.07"];
  edge [fontname="DejaVu Sans", fontsize=12];
  subgraph cluster_progetto { label=<<B>Il tuo codice (src/, applications/)</B>>; fontsize=17; style="rounded"; color="#2E6DB4"; penwidth=2; margin=16;
    s_stC [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>shockThermo.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">costruttore + preSolve()</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">registra &#x27;shockThermo&#x27; nella tabella solver</FONT></TD></TR></TABLE>>];
    s_stH [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>shockThermo.H</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">applications/modules/shockThermo/</FONT></TD></TR></TABLE>>];
    s_tp [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>thermophysicalPredictor.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">specie, energia e, equazione di eve</FONT></TD></TR></TABLE>>];
    s_rdt [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>setRDeltaT.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">passo locale (LTS)</FONT></TD></TR></TABLE>>];
    s_sf [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>shockFluid.H / shockFluid.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">applications/modules/shockFluid/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">copia modificata del core:</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">fluidThermo invece di psiThermo</FONT></TD></TR></TABLE>>];
    s_heH [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>highEnthalpyMulticomponentThermo.H</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">src/.../highEnthalpyMulticomponentThermo/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">classe astratta: Tve(), eve(), computeSourceVT()</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">classe composite: campi Tve_, eve_</FONT></TD></TR></TABLE>>];
    s_heC [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>highEnthalpyMulticomponentThermo.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">New(): chiama basicThermo::New</FONT></TD></TR></TABLE>>];
    s_heS [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>highEnthalpyMulticomponentThermos.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">istanziazioni statiche forCoeffGases/forGases</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">(janaf, eConst, hConst: MAI rrho)</FONT></TD></TR></TABLE>>];
    s_HE [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>HighEnthalpyMulticomponentThermo.H</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">IL BRIDGE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">costruttore, computeSourceVT(), correct(),</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">initMutation()</FONT></TD></TR></TABLE>>];
    s_rrho [shape=box, style="rounded,filled,dashed", fillcolor="#DCEBFA", color="#C62828", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>rrhoThermo.H / I.H / .C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">src/.../specie/thermo/rrho/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">copia rinominata di janafThermo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">non compilata da nessun target</FONT></TD></TR></TABLE>>];
    x_park [shape=box, style="rounded,filled,dashed", fillcolor="#DCEBFA", color="#C62828", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>Test-thermoMixturePark2T.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">applications/test/thermoMixturePark2T/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">include RRHOThermo.H che non esiste</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">non presente in nessun Allwmake</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_core { label=<<B>OpenFOAM-13 (core, non modificato)</B>>; fontsize=17; style="rounded"; color="#6E6E6E"; penwidth=2; margin=16;
    c_fluidSolver [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>fluidSolver.H</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">applications/modules/fluidSolver/</FONT></TD></TR></TABLE>>];
    c_solver [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>solver.H</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">src/finiteVolume/solver/</FONT></TD></TR></TABLE>>];
    c_comb [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>combustionModel.H / combustionModelNew.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">src/combustionModels/</FONT></TD></TR></TABLE>>];
    c_tr [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>header di trasporto e schemi</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">compressibleMomentumTransportModel.H</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">fluidThermoThermophysicalTransportModel.H</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">fluidMulticomponentThermophysicalTransportModel.H</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">multivariateScheme.H</FONT></TD></TR></TABLE>>];
    c_make [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>makeFluidMulticomponentThermo.H</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">+ makeThermo.H, forGases.H</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">macro che registrano i tipi nelle tabelle</FONT></TD></TR></TABLE>>];
    c_psi [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>psiThermo.H</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">src/thermophysicalModels/basic/</FONT></TD></TR></TABLE>>];
    c_fmc [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>fluidMulticomponentThermo.H</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">src/thermophysicalModels/multicomponentThermo/</FONT></TD></TR></TABLE>>];
    c_fluid [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>fluidThermo.H</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">src/thermophysicalModels/basic/</FONT></TD></TR></TABLE>>];
    c_mc [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>multicomponentThermo.H</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">src/thermophysicalModels/multicomponentThermo/</FONT></TD></TR></TABLE>>];
    c_basic [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>basicThermo.H</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">src/thermophysicalModels/basic/</FONT></TD></TR></TABLE>>];
    c_FMT [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>FluidMulticomponentThermo.H</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">template &lt;BaseThermo&gt;</FONT></TD></TR></TABLE>>];
    c_MT [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>MulticomponentThermo.H</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">template &lt;BaseThermo&gt;</FONT></TD></TR></TABLE>>];
    c_PT [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>PsiThermo.H</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">template &lt;Thermo&gt;</FONT></TD></TR></TABLE>>];
    c_BT [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>BasicThermo.H</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">template &lt;MixtureType, BasicThermoType&gt;</FONT></TD></TR></TABLE>>];
    c_janaf [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>janafThermo.H / I.H / .C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">src/thermophysicalModels/specie/thermo/janaf/</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_mpp { label=<<B>Mutation++ (thirdParty/)</B>>; fontsize=17; style="rounded"; color="#C66A00"; penwidth=2; margin=16;
    m_h [shape=box, style="rounded,filled,solid", fillcolor="#FDE8D0", color="#C66A00", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>mutation++.h</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">thirdParty/Mutationpp/install/include/mutation++/</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_caso { label=<<B>Casi e test</B>>; fontsize=17; style="rounded"; color="#3C8D3C"; penwidth=2; margin=16;
    t_n2 [shape=box, style="rounded,filled,solid", fillcolor="#E3F4E1", color="#3C8D3C", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>Test-N2.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">applications/test/nonEqTTv/N2/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">heat bath 0D con solo Mutation++</FONT></TD></TR></TABLE>>];
  }
  s_stC -> s_stH [color="#333333", arrowhead=normal];
  s_tp -> s_stH [color="#333333", arrowhead=normal];
  s_rdt -> s_stH [color="#333333", arrowhead=normal];
  s_stH -> s_sf [color="#8E24AA", arrowhead=empty, penwidth=2.2, label=" shockThermo : shockFluid "];
  s_sf -> c_fluidSolver [color="#8E24AA", arrowhead=empty, penwidth=2.2, label=" shockFluid : fluidSolver "];
  c_fluidSolver -> c_solver [color="#8E24AA", arrowhead=empty, penwidth=2.2, label=" fluidSolver : solver "];
  s_stH -> s_heH [color="#333333", arrowhead=normal, label=" #include "];
  s_stH -> c_comb [color="#333333", arrowhead=normal];
  s_stH -> c_tr [color="#333333", arrowhead=normal];
  s_sf -> c_tr [color="#333333", arrowhead=normal];
  s_heC -> s_heH [color="#333333", arrowhead=normal];
  s_heS -> s_heH [color="#333333", arrowhead=normal];
  s_heS -> c_make [color="#333333", arrowhead=normal, label=" #include "];
  s_heH -> s_HE [color="#333333", arrowhead=normal, label=" #include "];
  s_HE -> m_h [color="#333333", arrowhead=normal, label=" #include "];
  t_n2 -> m_h [color="#333333", arrowhead=normal, label=" #include "];
  s_heH -> c_psi [color="#8E24AA", arrowhead=empty, penwidth=2.2, label=" virtual "];
  s_heH -> c_fmc [color="#8E24AA", arrowhead=empty, penwidth=2.2, label=" virtual "];
  c_psi -> c_fluid [color="#8E24AA", arrowhead=empty, penwidth=2.2, label=" virtual "];
  c_fmc -> c_fluid [color="#8E24AA", arrowhead=empty, penwidth=2.2, label=" virtual "];
  c_fmc -> c_mc [color="#8E24AA", arrowhead=empty, penwidth=2.2, label=" virtual "];
  c_fluid -> c_basic [color="#8E24AA", arrowhead=empty, penwidth=2.2, label=" virtual "];
  c_mc -> c_basic [color="#8E24AA", arrowhead=empty, penwidth=2.2, label=" virtual "];
  s_HE -> c_FMT [color="#8E24AA", arrowhead=empty, penwidth=2.2, label=" HighEnthalpyMulticomponentThermo<T>
: FluidMulticomponentThermo<T> "];
  c_FMT -> c_MT [color="#8E24AA", arrowhead=empty, penwidth=2.2, label=" T = MulticomponentThermo<...> "];
  c_MT -> c_PT [color="#8E24AA", arrowhead=empty, penwidth=2.2, label=" BaseThermo = PsiThermo<...> "];
  c_PT -> c_BT [color="#8E24AA", arrowhead=empty, penwidth=2.2, label=" Thermo = BasicThermo<Mixture, composite> "];
  c_BT -> s_heH [color="#8E24AA", arrowhead=empty, penwidth=2.2, label=" BasicThermoType = composite
: highEnthalpyMulticomponentThermo ", constraint=false];
  s_rrho -> c_janaf [color="#9E9E9E", style=dashed, arrowhead=onormal, penwidth=1.4, label=" copia rinominata "];
  x_park -> s_rrho [color="#333333", arrowhead=normal, label=" #include "];
}
