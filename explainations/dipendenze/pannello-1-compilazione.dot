digraph G {
  graph [rankdir=TB, fontname="DejaVu Sans", labelloc=t, fontsize=30, pad=0.5, nodesep=0.45, ranksep=0.8, label=<<B>1 · Come si compila: ambiente, script, librerie</B><BR/> >];
  node [fontname="DejaVu Sans", fontsize=13, margin="0.14,0.07"];
  edge [fontname="DejaVu Sans", fontsize=12];
  subgraph cluster_env { label=<<B>Ambiente (source etc/bashrc)</B>>; fontsize=17; style="rounded"; color="#00796B"; penwidth=2; margin=16;
    env_bashrc [shape=box, style="rounded,filled,solid", fillcolor="#E0F2F1", color="#00796B", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>etc/bashrc</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">da sorgentare dopo OpenFOAM-13</FONT></TD></TR></TABLE>>];
    env_settings [shape=box, style="rounded,filled,solid", fillcolor="#E0F2F1", color="#00796B", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>etc/config.sh/settings</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">POLIMI_SRC, POLIMI_MODULES</FONT></TD></TR></TABLE>>];
    env_mpp [shape=box, style="rounded,filled,solid", fillcolor="#E0F2F1", color="#00796B", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>etc/config.sh/mutationpp</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">MPP_DIRECTORY, MPP_DATA_DIRECTORY</FONT></TD></TR></TABLE>>];
    env_user [shape=box, style="rounded,filled,solid", fillcolor="#E0F2F1", color="#00796B", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>~/.OpenFOAM/13/codeTemplates/</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">copia fatta da etc/bashrc</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">cercata PRIMA di $FOAM_ETC</FONT></TD></TR></TABLE>>];
    env_wl [shape=box, style="rounded,filled,solid", fillcolor="#E0F2F1", color="#00796B", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>etc/codeTemplates/dynamicCode/</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">fluidMulticomponentThermo, psiThermo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">whitelist dynamicCode (contiene rrho)</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_build { label=<<B>Script di compilazione</B>>; fontsize=17; style="rounded"; color="#5E4FA2"; penwidth=2; margin=16;
    b_mc [shape=box, style="rounded,filled,solid", fillcolor="#E8E4F6", color="#5E4FA2", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>multicomponentThermo/Make/</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">files + options</FONT></TD></TR></TABLE>>];
    b_st [shape=box, style="rounded,filled,solid", fillcolor="#E8E4F6", color="#5E4FA2", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>shockThermo/Make/</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">files + options</FONT></TD></TR></TABLE>>];
    b_n2 [shape=box, style="rounded,filled,solid", fillcolor="#E8E4F6", color="#5E4FA2", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>nonEqTTv/Allwmake  +  N2/Make/</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">non chiamato da Allwmake</FONT></TD></TR></TABLE>>];
    b_all [shape=box, style="rounded,filled,solid", fillcolor="#E8E4F6", color="#5E4FA2", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>Allwmake</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">radice</FONT></TD></TR></TABLE>>];
    b_src [shape=box, style="rounded,filled,solid", fillcolor="#E8E4F6", color="#5E4FA2", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>src/Allwmake</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">wmake all thermophysicalModels</FONT></TD></TR></TABLE>>];
    b_app [shape=box, style="rounded,filled,solid", fillcolor="#E8E4F6", color="#5E4FA2", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>applications/Allwmake</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">wmake all modules</FONT></TD></TR></TABLE>>];
    b_tp [shape=box, style="rounded,filled,solid", fillcolor="#E8E4F6", color="#5E4FA2", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>thirdParty/Allwmake</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">makeMutationpp</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">riga commentata in Allwmake:</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">si lancia a mano</FONT></TD></TR></TABLE>>];
    b_tm [shape=box, style="rounded,filled,solid", fillcolor="#E8E4F6", color="#5E4FA2", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>src/thermophysicalModels/Allwmake</B></TD></TR></TABLE>>];
    b_specie [shape=box, style="rounded,filled,solid", fillcolor="#E8E4F6", color="#5E4FA2", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>specie/Allwmake</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">solo wmakeLnInclude: nessuna libreria</FONT></TD></TR></TABLE>>];
    b_mod [shape=box, style="rounded,filled,solid", fillcolor="#E8E4F6", color="#5E4FA2", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>applications/modules/Allwmake</B></TD></TR></TABLE>>];
    b_sf [shape=box, style="rounded,filled,solid", fillcolor="#E8E4F6", color="#5E4FA2", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>shockFluid/Make/</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">files + options</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_progetto { label=<<B>Il tuo codice (src/, applications/)</B>>; fontsize=17; style="rounded"; color="#2E6DB4"; penwidth=2; margin=16;
    s_rrho [shape=box, style="rounded,filled,dashed", fillcolor="#DCEBFA", color="#C62828", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>rrhoThermo.H / I.H / .C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">src/.../specie/thermo/rrho/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">copia rinominata di janafThermo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">non compilata da nessun target</FONT></TD></TR></TABLE>>];
    s_heC [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>highEnthalpyMulticomponentThermo.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">New(): chiama basicThermo::New</FONT></TD></TR></TABLE>>];
    s_heS [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>highEnthalpyMulticomponentThermos.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">istanziazioni statiche forCoeffGases/forGases</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">(janaf, eConst, hConst: MAI rrho)</FONT></TD></TR></TABLE>>];
    s_sf [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>shockFluid.H / shockFluid.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">applications/modules/shockFluid/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">copia modificata del core:</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">fluidThermo invece di psiThermo</FONT></TD></TR></TABLE>>];
    s_stC [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>shockThermo.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">costruttore + preSolve()</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">registra &#x27;shockThermo&#x27; nella tabella solver</FONT></TD></TR></TABLE>>];
    s_tp [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>thermophysicalPredictor.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">specie, energia e, equazione di eve</FONT></TD></TR></TABLE>>];
    s_rdt [shape=box, style="rounded,filled,solid", fillcolor="#DCEBFA", color="#2E6DB4", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>setRDeltaT.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">passo locale (LTS)</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_bin { label=<<B>Librerie ed eseguibili prodotti</B>>; fontsize=17; style="rounded"; color="#A68A00"; penwidth=2; margin=16;
    lib_he [shape=component, style="rounded,filled,solid", fillcolor="#FFF4B8", color="#A68A00", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>libhighEnthalpyThermophysicalModels.so</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">$FOAM_USER_LIBBIN</FONT></TD></TR></TABLE>>];
    lib_sf [shape=component, style="rounded,filled,solid", fillcolor="#FFF4B8", color="#A68A00", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>libshockFluid.so</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">$FOAM_USER_LIBBIN</FONT></TD></TR></TABLE>>];
    lib_st [shape=component, style="rounded,filled,solid", fillcolor="#FFF4B8", color="#A68A00", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>libshockThermo.so</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">$FOAM_USER_LIBBIN</FONT></TD></TR></TABLE>>];
    lib_mpp [shape=component, style="rounded,filled,solid", fillcolor="#FFF4B8", color="#A68A00", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>libmutation++.so</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">thirdParty/Mutationpp/install/lib/</FONT></TD></TR></TABLE>>];
    exe_n2 [shape=component, style="rounded,filled,solid", fillcolor="#FFF4B8", color="#A68A00", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>Test-N2</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">$FOAM_USER_APPBIN</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_core { label=<<B>OpenFOAM-13 (core, non modificato)</B>>; fontsize=17; style="rounded"; color="#6E6E6E"; penwidth=2; margin=16;
    c_sfcore [shape=box, style="rounded,filled,solid", fillcolor="#EFEFEF", color="#6E6E6E", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>shockFluid/*.C del core</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">applications/modules/shockFluid/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">correctDensity, fluxPredictor, momentumPredictor,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">moveMesh, pressureCorrector, setRDeltaT,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">thermophysicalPredictor + derivedFvPatchFields</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_caso { label=<<B>Casi e test</B>>; fontsize=17; style="rounded"; color="#3C8D3C"; penwidth=2; margin=16;
    t_n2 [shape=box, style="rounded,filled,solid", fillcolor="#E3F4E1", color="#3C8D3C", penwidth=1.8, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>Test-N2.C</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">applications/test/nonEqTTv/N2/</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">heat bath 0D con solo Mutation++</FONT></TD></TR></TABLE>>];
  }
  env_bashrc -> env_settings [color="#00796B", style=dashed, penwidth=1.6, arrowhead=odiamond, label=" sorgenta "];
  env_bashrc -> env_mpp [color="#00796B", style=dashed, penwidth=1.6, arrowhead=odiamond, label=" sorgenta "];
  env_bashrc -> env_user [color="#00796B", style=dashed, penwidth=1.6, arrowhead=odiamond, label=" copia etc/codeTemplates "];
  env_wl -> env_user [color="#9E9E9E", style=dashed, arrowhead=onormal, penwidth=1.4, label=" copiato in "];
  env_settings -> b_mc [color="#00796B", style=dashed, penwidth=1.6, arrowhead=odiamond, label=" POLIMI_SRC "];
  env_settings -> b_st [color="#00796B", style=dashed, penwidth=1.6, arrowhead=odiamond, label=" POLIMI_SRC, POLIMI_MODULES "];
  env_mpp -> b_mc [color="#00796B", style=dashed, penwidth=1.6, arrowhead=odiamond, label=" MPP_DIRECTORY "];
  env_mpp -> b_st [color="#00796B", style=dashed, penwidth=1.6, arrowhead=odiamond, label=" MPP_DIRECTORY "];
  env_mpp -> b_n2 [color="#00796B", style=dashed, penwidth=1.6, arrowhead=odiamond, label=" MPP_DIRECTORY "];
  b_all -> b_src [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" 1 "];
  b_all -> b_app [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" 2 "];
  b_all -> b_tp [color="#9E9E9E", style=dashed, arrowhead=onormal, penwidth=1.4, label=" commentato "];
  b_src -> b_tm [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4];
  b_tm -> b_specie [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4];
  b_tm -> b_mc [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4];
  b_specie -> s_rrho [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" lnInclude "];
  b_mc -> s_heC [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" compila "];
  b_mc -> s_heS [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" compila "];
  b_mc -> lib_he [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" produce "];
  b_app -> b_mod [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4];
  b_mod -> b_sf [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4];
  b_mod -> b_st [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4];
  b_sf -> s_sf [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" compila "];
  b_sf -> c_sfcore [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" compila dal core "];
  b_sf -> lib_sf [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" produce "];
  b_st -> s_stC [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" compila "];
  b_st -> s_tp [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" compila "];
  b_st -> s_rdt [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" compila "];
  b_st -> lib_st [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" produce "];
  lib_he -> lib_mpp [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" linka "];
  lib_st -> lib_sf [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" linka "];
  lib_st -> lib_he [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" linka "];
  b_n2 -> t_n2 [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" compila "];
  b_n2 -> exe_n2 [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" produce "];
  exe_n2 -> lib_mpp [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" linka "];
  b_tp -> lib_mpp [color="#1565C0", style=dashed, arrowhead=vee, penwidth=1.4, label=" produce "];
}
